generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars      Car[]
  authCodes AuthCode[]
}

model AuthCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([email])
}

model Car {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  vin       String?
  make      String
  model     String
  year      Int?
  color     String?
  nickname  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services  ServiceRecord[]
  photos    CarPhoto[]

  @@index([userId])
}

model CarPhoto {
  id           String   @id @default(cuid())
  carId        String
  car          Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  filename     String
  originalName String?
  mimeType     String
  size         Int
  caption      String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([carId])
  @@index([carId, createdAt])
}

enum ServiceStatus {
  planned
  completed
}

model ServiceRecord {
  id                   String        @id @default(cuid())
  carId                String
  car                  Car           @relation(fields: [carId], references: [id], onDelete: Cascade)

  status               ServiceStatus @default(completed)
  title                String
  recommendedMileage   Int?
  performedAt          DateTime?
  mileage              Int?
  cost                 Decimal?      @db.Decimal(12, 2)
  workshop             String?
  category             String?
  notes                String?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([carId])
  @@index([carId, status])
  @@index([carId, performedAt])
}

model VehicleCache {
  id        String   @id @default(cuid())
  key       String   @unique
  source    String
  payload   Json
  fetchedAt DateTime @default(now())
}
